{
  "name": "living-syllabus",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "workspaces": [
    "packages/core",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test \"packages/core/**/*.test.ts\" \"packages/adapters/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
